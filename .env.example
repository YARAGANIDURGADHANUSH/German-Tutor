# Brain (the tutor): https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Ears + mouth: Azure AI Speech resource (Azure portal -> Create -> "Speech")
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# One bilingual voice that speaks both German and English cleanly.
# Check the current voice list in the Azure Speech docs if this name is rejected.
TTS_VOICE=de-DE-SeraphinaMultilingualNeural

# Your English accent for speech recognition (en-IN, en-US, en-GB ...)
STT_EN_LOCALE=en-IN

DB_PATH=tutor.db
